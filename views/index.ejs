<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weather App</title>
    <link rel="stylesheet" href="styles/main.css" />
  </head>
  <body>
    <div class="main-container">
      <div class="left-container">
        <h3>Sunny</h3>
        <p>Tanauan City</p>
        <h2>34°C</h2>
        <div class="location">
          <img src="/images/edit_location.svg" alt="location-icon" />
          <p>Change Location</p>
        </div>
      </div>
      <div class="right-container">
        <div class="metric">
          <div class="top-row">
            <img src="/images/humidity.svg" alt="humidity icon" />
            <h4>Humidity</h4>
          </div>
          <h3>50%</h3>
        </div>

        <div class="metric">
          <div class="top-row">
            <img src="/images/air_pressure.svg" alt="air-pressure icon" />
            <h4>Air Pressure</h4>
          </div>
          <h3>1008.483 PS</h3>
        </div>

        <div class="metric">
          <div class="top-row">
            <img src="./images/chance_of_rain.svg" alt="chance-of-rain icon" />
            <h4>Chance of Rain</h4>
          </div>
          <h3>70%</h3>
        </div>
        <div class="metric">
          <div class="top-row">
            <img src="/images/wind_speed.svg" alt="wind-speed icon" />
            <h4>Wind Speed</h4>
          </div>
          <h3>1.4 km/h%</h3>
        </div>
      </div>
    </div>
    <div class="bottom-horizontal-container">
      <div class="hourly-cards-container">
        <div class="card">
          <p>3PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>4PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>5PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>6PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>7PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>8PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>9PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>10PM</p>
          <h2>28°C</h2>
        </div>
      </div>

      <div class="navigational-arrows">
        <img src="/images/arrow_back.svg" alt="left arrow" />
        <img src="/images/arrow_forward.svg" alt="right arrow" />
      </div>
    </div>
  </body>
</html>
