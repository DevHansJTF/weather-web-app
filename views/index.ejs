<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Weather App</title>
  </head>
  <body>
    <div class="main-container">
      <div class="left-container">
        <h2>Fog</h2>
        <p>Tanauan City</p>
        <h1>28°C</h1>
        <div class="location">
          <img src="placeholder" alt="location icon" />
          <p>Change Location</p>
        </div>
      </div>
      <div class="right-container">
        <div class="humidity">
          <div class="top-row">
            <h3>Humidity</h3>
            <img src="placeholder" alt="humidity icon" />
          </div>
          <h2>50%</h2>
        </div>
        <div class="air-pressure">
          <div class="top-row">
            <h3>Air Pressure</h3>
            <img src="placeholder" alt="air-pressure icon" />
          </div>
          <h2>1008.483 PS</h2>
        </div>
        <div class="chance-of-rain">
          <div class="top-row">
            <h3>Chance of Rain</h3>
            <img src="placeholder" alt="chance-of-rain icon" />
          </div>
          <h2>70%</h2>
        </div>
        <div class="wind-speed">
          <div class="top-row">
            <h3>Wind Speed</h3>
            <img src="placeholder" alt="wind-speed icon" />
          </div>
          <h2>1.4 km/h%</h2>
        </div>
      </div>
    </div>
    <div class="bottom-horizontal-container">
      <div class="hourly-cards-container">
        <div class="card">
          <p>3PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>4PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>5PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>6PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>7PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>8PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>9PM</p>
          <h2>28°C</h2>
        </div>
        <div class="card">
          <p>10PM</p>
          <h2>28°C</h2>
        </div>
      </div>

      <div class="navigational-arrows">
        <img src="placeholder" alt="left arrow" />
        <img src="placeholde" alt="left arrow" />
      </div>
    </div>
  </body>
</html>
